// Configuración explícita de Cloudflare Workers (assets estáticos del build de Vite).
// Con este archivo, `npx wrangler deploy` no depende de la autodetección del framework.
{
  "name": "reyesautoglass",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
